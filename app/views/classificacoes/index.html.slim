.d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.mb-4.gap-3
  div
    h2.mb-1 Classificações
    p.text-muted.mb-0
      = @pagy.count
      |  classificações encontradas

  .d-flex.gap-2
    = link_to new_classificacao_path, class: 'btn btn-primary'
      i.bi.bi-plus-lg.me-1
      | Nova Classificação

.card.border-0.shadow-sm.mb-4
  .card-body.py-3
    = search_form_for(@q, url: request.original_url, html: { class: 'd-flex flex-column flex-md-row gap-3' }) do |f|
      .flex-grow-1
        = f.search_field :nome_cont, class: 'form-control', placeholder: 'Buscar por nome...'
      .d-flex.gap-2.align-items-center
        = f.select :tipo_eq, \
          options_for_select(Classificacao.tipos.map { |nome, valor| [nome, valor] }, params.dig(:q, :tipo_eq)), \
          { include_blank: 'Todos os tipos' }, \
          class: 'form-select form-select-sm'
        = button_tag class: 'btn btn-sm btn-primary'
          i.bi.bi-search

.card.border-0.shadow-sm
  .table-responsive
    table.table.table-hover.align-middle.mb-0
      thead
        tr.text-muted.small.text-uppercase
          th.ps-4 Tipo
          th Classificação
      tbody
        - @classificacoes.each do |classificacao|
          tr
            td.ps-4
              span.badge.bg-secondary= classificacao.tipo
            td
              .fw-semibold
                = link_to classificacao.nome, edit_classificacao_path(classificacao), class: 'text-decoration-none'

  - if @pagy.pages > 1
    .card-footer.bg-transparent.border-top.d-flex.justify-content-center.py-3
      == pagy_bootstrap_nav(@pagy)