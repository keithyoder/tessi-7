= simple_form_for(@conexao) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  - current_ip    = @conexao.ip.to_s
  - current_ipv6  = @conexao.ipv6.to_s
  - current_caixa = @conexao.caixa_id.to_i
  - map           = conexao_map_center(@conexao)
  - pessoa        = @conexao.pessoa

  div[data-controller="conexao" data-conexao-current-ip-value=current_ip data-conexao-current-ipv6-value=current_ipv6 data-conexao-current-caixa-id-value=current_caixa]

    / ── Identificação ───────────────────────────────────────────────────
    .card.mb-3
      .card-header Identificação
      .card-body
        .row.g-3
          .col-12.col-md
            .form-group
              label.form-label Pessoa
              .position-relative
                = f.hidden_field :pessoa_id, data: { conexao_target: "pessoaId" }
                input.form-control type="text" placeholder="Digite para buscar..." value=pessoa&.nome autocomplete="off" data-conexao-target="pessoaInput" data-action="input->conexao#searchPessoa"
          .col-12.col-md-3
            = f.input :tipo, collection: Conexao.tipos.keys, input_html: { data: { action: "change->conexao#tipoChanged", conexao_target: "tipo" } }
          .col-12.col-md-2[data-conexao-target="contratoWrapper"]
            = f.association :contrato, collection: @contratos, label_method: :id

    / ── Conexão ─────────────────────────────────────────────────────────
    .card.mb-3
      .card-header Conexão
      .card-body
        .row.g-3
          .col-12.col-md-4
            = f.association :plano, collection: Plano.ativos(@conexao.contrato&.plano).order(:nome), label_method: :nome
          .col-12.col-md
            = f.input :velocidade
          .col-12.col-md-4
            = f.association :equipamento, collection: Equipamento.cpe.order(:fabricante, :modelo), label_method: :descricao

        .row.g-3.mt-1
          .col-12.col-md-8
            = f.input :observacao
          .col-12.col-md
            = f.input :bloqueado
            = f.input :inadimplente
            = f.input :auto_bloqueio

    / ── Rede ────────────────────────────────────────────────────────────
    .card.mb-3
      .card-header Rede
      .card-body
        .row.g-3
          .col-12.col-md-4
            = f.association :ponto, collection: Ponto.ativo.order(:nome), label_method: :nome, input_html: { data: { action: "change->conexao#pontoChanged", conexao_target: "ponto" } }
          .col-12.col-md-4
            = f.input :ip, collection: [current_ip] + (@conexao.ponto&.ipv4_disponiveis.to_a.map(&:to_s)), input_html: { data: { conexao_target: "ip" } }
          .col-12.col-md-4
            = f.input :ipv6, collection: [current_ipv6] + (@conexao.ponto&.ipv6_disponiveis.to_a.map(&:to_s)), input_html: { data: { conexao_target: "ipv6" } }

        .row.g-3.mt-1
          .col-12.col-md-3
            = f.input :mac, input_html: { data: { action: "input->conexao#formatMAC", conexao_target: "mac" } }
          .col-12.col-md
            = f.input :usuario
          .col-12.col-md-2
            = f.input :senha

        .row.g-3.mt-1[data-conexao-target="caixaPortaWrapper"]
          .col-12.col-md
            = f.association :caixa, collection: @caixas, label_method: :nome, include_blank: '— nenhuma —', input_html: { data: { conexao_target: "caixa" } }
          .col-12.col-md-2
            = f.input :porta, as: :select, collection: opcoes_porta, include_blank: '— nenhuma —'

    / ── Localização ─────────────────────────────────────────────────────
    .card.mb-3
      .card-header Localização
      .card-body[data-controller="geolocation"]
        .row.g-3
          .col-12.col-md-6
            .form-group
              label.form-label Logradouro
              .position-relative
                = f.hidden_field :logradouro_id, data: { conexao_target: "logradouroId" }
                input.form-control type="text" placeholder=pessoa&.logradouro&.endereco value=@conexao.logradouro&.endereco autocomplete="off" data-conexao-target="logradouroInput" data-action="input->conexao#searchLogradouro"
          .col-12.col-md
            = f.input :numero, placeholder: pessoa&.numero, hint: false
          .col-12.col-md
            = f.input :complemento, placeholder: pessoa&.complemento, hint: false

    = render partial: 'shared/localizacao', locals: { f:, titulo: pessoa&.nome || 'Localização' }

  / ── Actions ─────────────────────────────────────────────────────────
  .d-flex.gap-2.mt-3
    button.btn.btn-primary type="submit"
      i.bi.bi-floppy aria-hidden="true"
      |  Salvar
