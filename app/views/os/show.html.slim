/ app/views/os/show.html.slim

/ Hero Section
.row.mb-4
  .col-12
    .card.border-0.shadow-sm
      .card-body.p-4
        .d-flex.justify-content-between.align-items-start.flex-wrap
          div
            .d-flex.align-items-center.gap-3.mb-2
              h2.mb-0 OS ##{@os.id}
              - if @os.fechamento.nil?
                span.badge.bg-warning.text-dark.fs-6 Aberta
              - else
                span.badge.bg-secondary.fs-6 Fechada
              - sla_status = @os.sla_status
              - if sla_status != :sem_sla
                - sla_badge = { no_prazo: 'bg-success', em_risco: 'bg-warning text-dark', atrasado: 'bg-danger' }[sla_status]
                - sla_label = { no_prazo: 'No prazo', em_risco: 'Em risco', atrasado: 'Atrasado' }[sla_status]
                span.badge class="#{sla_badge} fs-6"
                  = sla_label
            .text-muted
              = @os.tipo
              - if @os.classificacao
                = " • "
                = @os.classificacao.nome
              - if @os.os_origem.present?
                = " • "
                | Reagendamento de
                = " "
                = link_to "OS ##{@os.os_origem.id}", @os.os_origem, class: 'text-decoration-none'

          .d-flex.gap-2.mt-3.mt-md-0
            = back_button(os_index_path)
            - if @os.fechamento.nil?
              = action_button os_encerramento_path(@os), \
                css_class: 'btn btn-primary', text: 'Encerrar OS', icon: 'bi-check-circle'
              = action_button os_path(@os, format: :pdf), \
                css_class: 'btn btn-outline-secondary', text: 'Imprimir', icon: 'bi-printer', \
                data: { turbo: false }, target: '_blank'
            = edit_button(@os)
            = delete_button(@os)

/ Vínculos
- if @os.conexao.present?
  .row.mb-4
    .col-md-4
      = link_to @os.conexao, class: 'text-decoration-none'
        .card.border-0.shadow-sm.h-100
          .card-body
            .text-muted.small.mb-1 Conexão
            .fw-bold= @os.conexao.ip.to_s
            .small.text-muted= @os.conexao.usuario
            .small.text-muted= @os.conexao.ponto.nome
            .small.text-muted= @os.conexao.endereco

/ Detalhes
.row.mb-4
  .col-12
    .card.border-0.shadow-sm
      .card-body
        .row.g-4
          .col-md-4
            .text-muted.small Assinante
            .fw-medium= link_to @os.pessoa.nome, @os.pessoa, class: 'text-decoration-none'
          .col-md-4
            .text-muted.small Aberto Por
            .fw-medium= @os.aberto_por.primeiro_nome

          .col-md-4
            .text-muted.small Responsável
            .fw-medium= @os.responsavel.primeiro_nome
          - tecnicos = [@os.tecnico_1, @os.tecnico_2].compact
          - if tecnicos.any?
            .col-md-4
              .text-muted.small= 'Técnico'.pluralize(tecnicos.size)
              .fw-medium= tecnicos.map(&:primeiro_nome).join(', ')

          .col-md-4
            .text-muted.small Aberta em
            .fw-medium= l(@os.created_at, format: :date_time)
          - if @os.agendado_em.present?
            .col-md-4
              .text-muted.small Agendada para
              .fw-medium= l(@os.agendado_em)
          - if @os.fechamento.present?
            .col-md-4
              .text-muted.small Fechada em
              .fw-medium= l(@os.fechamento, format: :date_time)
          - if @os.conexao&.link_google_maps
            .col-md-4
              .text-muted.small Localização
              .d-flex.align-items-center.gap-2
                .fw-medium= link_to 'Ver no Google Maps', @os.conexao.link_google_maps, target: '_blank', class: 'text-decoration-none'
                button.btn.btn-sm.btn-outline-secondary type="button" title="Copiar link" data-controller="clipboard" data-clipboard-text-value=@os.conexao.link_google_maps data-action="clipboard#copy"
                  i.bi.bi-clipboard

/ Descrição & Encerramento
.row.g-4
  .col-md-6
    .card.border-0.shadow-sm.h-100
      .card-header.bg-white.border-bottom
        h5.mb-0
          i.bi.bi-file-text.me-2
          | Descrição
      .card-body
        = simple_format(@os.descricao)
  - if @os.encerramento.present?
    .col-md-6
      .card.border-0.shadow-sm.h-100
        .card-header.bg-white.border-bottom
          h5.mb-0
            i.bi.bi-check-circle.me-2
            | Encerramento
        .card-body
          - if @os.resultado.present?
            - resultado_labels = { 'resolvido' => 'Resolvido', 'sem_problema_encontrado' => 'Sem problema encontrado', 'nao_despachado' => 'Não despachado', 'nao_resolvido' => 'Não resolvido', 'cliente_ausente' => 'Cliente ausente' }
            - resultado_badges = { 'resolvido' => 'bg-success', 'sem_problema_encontrado' => 'bg-info', 'nao_despachado' => 'bg-secondary', 'nao_resolvido' => 'bg-danger', 'cliente_ausente' => 'bg-warning text-dark' }
            span.badge class="#{resultado_badges[@os.resultado]} mb-2"
              = resultado_labels[@os.resultado]
          p.mb-0.text-break= @os.encerramento