.d-flex.justify-content-between.align-items-start.mb-4
  div
    h1.h3.mb-1 = @enlace.to_s
    span.badge.bg-secondary = @enlace.tecnologia
  .d-flex.gap-2
    = edit_button(@enlace)
    = delete_button(@enlace)
    = back_button(enlaces_path)

.row.g-3.mb-4
  .col-md-3.col-6
    .card.h-100
      .card-body
        .text-muted.small Tecnologia
        .fs-5.fw-semibold = @enlace.tecnologia

  - if @enlace.tecnologia_Radio?
    .col-md-3.col-6
      .card.h-100
        .card-body
          .text-muted.small Canal
          .fs-5.fw-semibold = @enlace.canal_atual.presence || '—'
    .col-md-3.col-6
      .card.h-100
        .card-body
          .text-muted.small SSID
          .fs-5.fw-semibold = @enlace.ssid_atual.presence || '—'
    .col-md-3.col-6
      .card.h-100
        .card-body
          .text-muted.small Distância
          .fs-5.fw-semibold = @enlace.distancia_atual.presence || '—'
    .col-md-3.col-6
      .card.h-100
        .card-body
          .text-muted.small Taxa (TX / RX)
          .fs-5.fw-semibold = @enlace.taxa_atual.presence || '—'
  - else
    .col-md-3.col-6
      .card.h-100
        .card-body
          .text-muted.small Cor da fibra
          .fs-5.fw-semibold = @enlace.fibra_cor&.capitalize || '—'

  .col-md-3.col-6
    .card.h-100
      .card-body
        .text-muted.small Capacidade
        .fs-5.fw-semibold = @enlace.capacidade_formatada || '—'

  .col-md-3.col-6
    .card.h-100
      .card-body
        .text-muted.small Sinal normal
        .fs-5.fw-semibold = @enlace.sinal_normal_formatado || '—'

.row.g-3.mb-4
  - [@enlace.ponta_a, @enlace.ponta_b].each do |extremidade|
    .col-md-6
      .card.h-100
        .card-header.fw-semibold
          = "Ponta #{extremidade.posicao}"
        .card-body
          - if extremidade.infraestrutura
            dl.row.mb-0
              dt.col-sm-4 Infraestrutura
              dd.col-sm-8
                = link_to extremidade.infraestrutura.to_s, polymorphic_path(extremidade.infraestrutura)
                span.badge.bg-light.text-dark.ms-2 = infraestrutura_tipo_humanizado(extremidade.infraestrutura_type)

              - if extremidade.ip.present?
                dt.col-sm-4 IP
                dd.col-sm-8
                  = link_to extremidade.ip.to_s, "https://#{extremidade.ip}", target: '_blank', rel: 'noopener noreferrer'
                  i.bi.bi-box-arrow-up-right.ms-1.small

              - if extremidade.device
                dt.col-sm-4 Equipamento
                dd.col-sm-8 = extremidade.device.equipamento&.descricao || 'Não identificado'

                dt.col-sm-4 MAC
                dd.col-sm-8 = extremidade.device.mac

              - if extremidade.sinal_atual
                dt.col-sm-4 Sinal
                dd.col-sm-8 = extremidade.sinal_atual
          - else
            p.text-muted.mb-0 Nenhuma infraestrutura vinculada.

- if @enlace.observacoes.present?
  .card
    .card-header.fw-semibold Observações
    .card-body
      p.mb-0 = simple_format(@enlace.observacoes)