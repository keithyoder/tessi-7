.d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.mb-4.gap-3
  div
    h2.mb-1 Concentradores
    p.text-muted.mb-0
      = @pagy.count
      |  concentradores encontrados

  .d-flex.gap-2
    = link_to new_servidor_path, class: 'btn btn-primary'
      i.bi.bi-plus-lg.me-1
      | Novo Concentrador

.card.border-0.shadow-sm.mb-4
  .card-body.py-3
    = search_form_for(@q, url: servidores_path, html: { class: 'd-flex flex-column flex-md-row gap-3' }) do |f|
      .flex-grow-1
        = f.search_field :nome_cont, class: 'form-control', placeholder: 'Buscar por nome...'
      .d-flex.gap-2.align-items-center
        - filter_val = params.dig(:q, :ativo_eq)
        .btn-group role="group"
          = link_to servidores_path(q: @search_params.except('ativo_eq')), \
            class: "btn btn-sm #{filter_val.blank? ? 'btn-secondary' : 'btn-outline-secondary'}"
            | Todos
          = link_to servidores_path(q: @search_params.merge('ativo_eq' => 'true')), \
            class: "btn btn-sm #{filter_val == 'true' ? 'btn-success' : 'btn-outline-secondary'}"
            i.bi.bi-check-circle.me-1
            | Ativos
          = link_to servidores_path(q: @search_params.merge('ativo_eq' => 'false')), \
            class: "btn btn-sm #{filter_val == 'false' ? 'btn-danger' : 'btn-outline-secondary'}"
            i.bi.bi-x-circle.me-1
            | Inativos
        = button_tag class: 'btn btn-sm btn-primary'
          i.bi.bi-search

.card.border-0.shadow-sm
  .table-responsive
    table.table.table-hover.align-middle.mb-0
      thead
        tr.text-muted.small.text-uppercase
          th.ps-4 Nome
          th IP
          th.d-none.d-lg-table-cell Equipamento
          th.d-none.d-md-table-cell Autenticando?
          th.text-center Status
      tbody
        - @servidores.each do |servidor|
          tr
            td.ps-4
              .fw-semibold= link_to servidor.nome, servidor, class: 'text-decoration-none'
            td = servidor.ip.to_s
            td.d-none.d-lg-table-cell
              - device = servidor.device
              - if device&.equipamento
                = device.equipamento.modelo
              - elsif device&.board_name
                span.text-muted title="Modelo não cadastrado em Equipamento" = device.board_name
              - else
                span.text-muted —
            td.d-none.d-md-table-cell
              - if servidor.autenticando?
                span.badge.bg-success Autenticando
              - else
                span.text-muted —
            td.text-center
              - device = servidor.device
              - if device&.last_seen_at&.> 10.minutes.ago
                span.badge.bg-success Online
              - elsif device&.last_seen_at
                span.badge.bg-secondary Offline
              - else
                span.text-muted —
  - if @pagy.pages > 1
    .card-footer.bg-transparent.border-top.d-flex.justify-content-center.py-3
      == pagy_bootstrap_nav(@pagy)