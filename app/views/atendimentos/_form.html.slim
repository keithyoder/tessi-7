= simple_form_for @atendimento do |f|
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  - pessoa = f.object.pessoa

  / ── Atendimento ─────────────────────────────────────────────────────
  .card.mb-3
    .card-header Atendimento
    .card-body
      .row.g-3
        .col-12.col-md[data-controller="busca" data-busca-url-value="/pessoas.json" data-busca-campos-meta-value='["cpf","endereco"]']
          .form-group
            label.form-label Pessoa
            .position-relative
              = f.hidden_field :pessoa_id, data: { busca_target: "id" }
              input.form-control type="text" placeholder="Digite para buscar..." value=pessoa&.nome autocomplete="off" data-busca-target="input" data-action="input->busca#buscar"
        .col-12.col-md
          = f.association :classificacao, collection: Classificacao.atendimentos.order(:nome), label_method: :nome
        .col-12.col-md
          = f.association :responsavel, collection: usuarios_atendentes_collection, label_method: :primeiro_nome

  / ── Vínculos (opcional) ─────────────────────────────────────────────
  .card.mb-3
    .card-header Vínculos (opcional)
    .card-body
      - if pessoa.present?
        .row.g-3
          .col-12.col-md
            = f.association :contrato, label_method: ->(contrato) { label_contrato(contrato) }, collection: pessoa.contratos.order(adesao: :desc), include_blank: '— nenhum —'
          .col-12.col-md
            = f.association :conexao, as: :select, label_method: ->(conexao) { label_conexao_form(conexao) }, collection: pessoa.conexoes.includes(:ponto), include_blank: '— nenhuma —'
          .col-12.col-md
            = f.association :fatura, label_method: ->(fatura) { label_fatura(fatura) }, collection: Fatura.where(contrato: pessoa.contratos).order(vencimento: :desc), include_blank: '— nenhuma —'
      - else
        p.text-muted.small.mb-0 Selecione uma pessoa para vincular a um contrato, conexão ou fatura específicos.

  / ── Detalhe inicial (apenas na criação) ────────────────────────────
  - if f.object.new_record?
    .card.mb-3
      .card-header Detalhe inicial
      .card-body
        .row.g-3
          .col-12.col-md-3
            = f.input :detalhe_tipo, collection: AtendimentoDetalhe.tipos.keys, label: 'Tipo'
          .col-12
            = f.input :detalhe_descricao, label: 'Descrição', input_html: { rows: 3 }

  .d-flex.gap-2.mt-3
    button.btn.btn-primary type="submit"
      i.bi.bi-floppy aria-hidden="true"
      |  Salvar