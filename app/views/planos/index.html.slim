/ Header
.d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.mb-4.gap-3
  div
    h2.mb-1 Planos de Acesso
    p.text-muted.mb-0
      = @pagy.count
      |  planos encontrados

  .d-flex.gap-2
    = link_to new_plano_path, class: 'btn btn-primary'
      i.bi.bi-plus-lg.me-1
      | Novo Plano

/ Search & Filters
.card.border-0.shadow-sm.mb-4
  .card-body.py-3
    = search_form_for(@q, url: request.original_url, html: { class: 'd-flex flex-column flex-md-row gap-3' }) do |f|
      .flex-grow-1
        = f.search_field :nome_cont, class: 'form-control', placeholder: 'Buscar por nome...'
      .d-flex.gap-2.align-items-center
        - ativo_filter = params.dig(:q, :ativo_eq)
        .btn-group role="group"
          = link_to planos_path(q: @search_params.except('ativo_eq')), \
            class: "btn btn-sm #{ativo_filter.blank? ? 'btn-secondary' : 'btn-outline-secondary'}"
            | Todos
          = link_to planos_path(q: @search_params.merge('ativo_eq' => 'true')), \
            class: "btn btn-sm #{ativo_filter == 'true' ? 'btn-success' : 'btn-outline-secondary'}"
            i.bi.bi-check-circle.me-1
            | Ativos
          = link_to planos_path(q: @search_params.merge('ativo_eq' => 'false')), \
            class: "btn btn-sm #{ativo_filter == 'false' ? 'btn-danger' : 'btn-outline-secondary'}"
            i.bi.bi-x-circle.me-1
            | Inativos
        = button_tag class: 'btn btn-sm btn-primary'
          i.bi.bi-search

/ Table
.card.border-0.shadow-sm
  .table-responsive
    table.table.table-hover.align-middle.mb-0
      thead
        tr.text-muted.small.text-uppercase
          th.ps-4 Plano
          th Mensalidade
          th.d-none.d-md-table-cell Velocidade
          th.d-none.d-lg-table-cell Desconto
          th.text-center Burst
          th.text-center Status
      tbody
        - @planos.each do |plano|
          tr
            td.ps-4
              .fw-semibold= link_to plano.nome, plano, class: 'text-decoration-none'
            td
              = number_to_currency(plano.mensalidade, unit: 'R$ ', separator: ',', delimiter: '.')
            td.d-none.d-md-table-cell
              span.badge.bg-light.text-dark.font-monospace= plano_velocidade(plano)
            td.d-none.d-lg-table-cell
              - if plano.desconto.present? && plano.desconto > 0
                span.text-success= number_to_currency(plano.desconto, unit: 'R$ ', separator: ',', delimiter: '.')
              - else
                span.text-muted —
            td.text-center
              - if plano.burst?
                span.badge.bg-warning.text-dark
                  i.bi.bi-lightning-fill.me-1
                  | Sim
              - else
                span.text-muted —
            td.text-center
              - if plano.ativo?
                span.badge.bg-success Ativo
              - else
                span.badge.bg-danger Inativo

  - if @pagy.pages > 1
    .card-footer.bg-transparent.border-top.d-flex.justify-content-center.py-3
      == pagy_bootstrap_nav(@pagy)