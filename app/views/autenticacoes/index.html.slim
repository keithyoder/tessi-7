turbo-frame id=id_frame
  - unless incorporado?
    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.mb-4.gap-3
      div
        h2.mb-1 Autenticações
        p.text-muted.mb-0
          = @pagy.count
          |  autenticações encontradas

  .card.border-0.shadow-sm
    .table-responsive
      table.table.table-hover.align-middle.mb-0
        thead
          tr.text-muted.small.text-uppercase
            th.ps-4 Usuário
            th Resultado
            th.text-end.pe-4 Data
        tbody
          - @autenticacoes.each do |autenticacao|
            tr
              td.ps-4 = link_to autenticacao.username, autenticacao.conexao, class: 'text-decoration-none'
              td = autenticacao.reply
              td.text-end.pe-4 = l(autenticacao.authdate, format: :date_time)

    - if @pagy.pages > 1
      .card-footer.bg-transparent.border-top.d-flex.justify-content-center.py-3
        == pagy_bootstrap_nav(@pagy)