= turbo_frame_tag id_frame do
  - if incorporado?
    .d-flex.justify-content-between.align-items-center.mb-3
      h5.mb-0 Enlaces
      = link_to new_enlace_path, class: 'btn btn-sm btn-primary'
        i.bi.bi-plus-lg.me-1
        | Novo Enlace
  - else
    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.mb-4.gap-3
      div
        h2.mb-1 Enlaces
        p.text-muted.mb-0
          = @pagy.count
          |  enlaces encontrados
      .d-flex.gap-2
        = link_to new_enlace_path, class: 'btn btn-primary'
          i.bi.bi-plus-lg.me-1
          | Novo Enlace

    .card.border-0.shadow-sm.mb-4
      .card-body.py-3
        = search_form_for(@q, url: enlaces_path, html: { class: 'd-flex flex-column flex-md-row gap-3' }) do |f|
          - tecnologia_atual = params.dig(:q, :tecnologia_eq)
          .flex-grow-1
            select.form-select name="q[tecnologia_eq]"
              option value="" Todas as tecnologias
              - Enlace.tecnologias.keys.each do |tecnologia|
                option value=tecnologia selected=(tecnologia_atual == tecnologia)
                  = tecnologia
          = button_tag class: 'btn btn-sm btn-primary'
            i.bi.bi-search

  .card.border-0.shadow-sm
    .table-responsive
      table.table.table-hover.align-middle.mb-0
        thead
          tr.text-muted.small.text-uppercase
            th.ps-4 Enlace
            th Tecnologia
            th.d-none.d-md-table-cell Canal / Cor
            th.d-none.d-lg-table-cell Capacidade
            th.text-center Sinal
        tbody
          - @enlaces.each do |enlace|
            tr
              td.ps-4
                .fw-semibold = link_to enlace.to_s, enlace, class: 'text-decoration-none'
              td = enlace.tecnologia
              td.d-none.d-md-table-cell
                - if enlace.tecnologia_Radio?
                  = enlace.canal.presence || content_tag(:span, '—', class: 'text-muted')
                - else
                  = enlace.fibra_cor&.capitalize || content_tag(:span, '—', class: 'text-muted')
              td.d-none.d-lg-table-cell
                = enlace.capacidade_formatada || content_tag(:span, '—', class: 'text-muted')
              td.text-center
                = enlace.sinal_normal_formatado || content_tag(:span, '—', class: 'text-muted')

    - if @pagy.pages > 1
      .card-footer.bg-transparent.border-top.d-flex.justify-content-center.py-3
        == pagy_bootstrap_nav(@pagy)