/ app/views/pontos/show.html.slim

/ Hero Section
.row.mb-4
  .col-12
    .card.border-0.shadow-sm
      .card-body.p-4
        .d-flex.justify-content-between.align-items-start.flex-wrap
          div
            .d-flex.align-items-center.gap-3.mb-2
              h2.mb-0 = @ponto.nome
              - if @ponto.tecnologia_Radio?
                span.badge.bg-primary.fs-6
                  i.bi.bi-broadcast
                  = " #{@ponto.tecnologia}"
              - else
                span.badge.bg-success.fs-6
                  i.bi.bi-diagram-3
                  = " #{@ponto.tecnologia}"
            .text-muted
              = @ponto.sistema
              = " • "
              = link_to @ponto.servidor.nome, @ponto.servidor, class: "text-decoration-none"

          .d-flex.gap-2.mt-3.mt-md-0
            = link_to ponto_path(@ponto, format: :kml), class: 'btn btn-outline-secondary btn-sm', data: { turbo: false }
              i.bi.bi-download.me-1
              | KML
            = link_to ponto_path(@ponto, format: :geojson), class: 'btn btn-outline-secondary btn-sm', data: { turbo: false }
              i.bi.bi-download.me-1
              | GeoJSON
            = back_button(pontos_path)
            = edit_button(@ponto)
            = delete_button(@ponto)

/ Quick Stats
.row.g-3.mb-4
  .col-md-3.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Conexões
        .fs-3.fw-bold.text-primary = @ponto.conexoes.count
  .col-md-3.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Bloqueados
        .fs-3.fw-bold class="#{@ponto.conexoes.bloqueado.count > 0 ? 'text-danger' : 'text-success'}"
          = @ponto.conexoes.bloqueado.count
  .col-md-3.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Ativos
        .fs-3.fw-bold.text-success = @ponto.conexoes.ativo.count
  .col-md-3.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Redes IP
        .fs-3.fw-bold.text-info = @ponto.ip_redes.count

/ Navigation Tabs
ul.nav.nav-tabs.mb-4 role="tablist"
  = render 'shared/nav_tab_link', id: 'overview', icon: 'bi-info-circle', label: 'Visão Geral', active: true
  = render 'shared/nav_tab_link', id: 'network', icon: 'bi-hdd-network', label: 'Rede & IPs'
  = render 'shared/nav_tab_link', id: 'map', icon: 'bi-geo-alt', label: 'Mapa'
  = render 'shared/nav_tab_link', id: 'conexoes', icon: 'bi-people', label: 'Conexões', badge: @ponto.conexoes.count
  = render 'shared/nav_tab_link', id: 'enlaces', icon: 'bi-link-45deg', label: 'Enlaces'
  = render 'shared/nav_tab_link', id: 'os', icon: 'bi-clipboard-check', label: 'Ordens de Serviço'
  - if @ponto.sistema_Ubnt? && @ponto.device
    = render 'shared/nav_tab_link', id: 'backups', icon: 'bi-clock-history', label: 'Backups', badge: @ponto.device.backups.count

/ Tab Content
.tab-content
  = render 'pontos/tabs/overview', ponto: @ponto
  = render 'pontos/tabs/network', ponto: @ponto
  = render 'pontos/tabs/map', ponto: @ponto
  = render 'pontos/tabs/conexoes', ponto: @ponto
  = render 'pontos/tabs/enlaces', ponto: @ponto
  = render 'pontos/tabs/os', ponto: @ponto
  - if @ponto.sistema_Ubnt?
    = render 'pontos/tabs/backups', ponto: @ponto