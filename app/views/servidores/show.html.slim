/ Hero Section
.row.mb-4
  .col-12
    .card.border-0.shadow-sm
      .card-body.p-4
        .d-flex.justify-content-between.align-items-start.flex-wrap
          div
            .d-flex.align-items-center.gap-3.mb-2
              h2.mb-0 = @servidor.nome
              - if @online
                span.badge.bg-success.fs-6
                  i.bi.bi-wifi
                  = " Online"
              - else
                span.badge.bg-danger.fs-6
                  i.bi.bi-wifi-off
                  = " Offline"
              - unless @servidor.ativo
                span.badge.bg-secondary.fs-6 Inativo
            .text-muted
              = @servidor.ip

          .d-flex.gap-2.mt-3.mt-md-0
            = link_to mapa_servidor_path, class: 'btn btn-outline-secondary btn-sm'
              i.bi.bi-map.me-1
              | Mapa
            = link_to backup_servidor_path, class: 'btn btn-outline-secondary btn-sm'
              i.bi.bi-save.me-1
              | Criar Backup
            - if @servidor.backup.attached?
              = link_to rails_blob_path(@servidor.backup, disposition: 'attachment'), class: 'btn btn-outline-secondary btn-sm'
                i.bi.bi-download.me-1
                = "Há #{time_ago_in_words(@servidor.backup.created_at)}"
            = back_button(servidores_path)
            = edit_button(@servidor)
            = delete_button(@servidor)

/ Quick Stats
.row.g-3.mb-4
  .col-md-3.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Pontos
        .fs-3.fw-bold.text-info = @servidor.pontos.count
  .col-md-3.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Conexões
        .fs-3.fw-bold.text-primary = @servidor.conexoes.count
  .col-md-3.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Bloqueados
        .fs-3.fw-bold class="#{@servidor.conexoes.bloqueado.count > 0 ? 'text-danger' : 'text-success'}"
          = @servidor.conexoes.bloqueado.count
  .col-md-3.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Inadimplentes
        .fs-3.fw-bold class="#{@servidor.conexoes.inadimplente.count > 0 ? 'text-danger' : 'text-success'}"
          = @servidor.conexoes.inadimplente.count

/ Navigation Tabs
ul.nav.nav-tabs.mb-4 role="tablist"
  = render 'shared/nav_tab_link', id: 'overview', icon: 'bi-info-circle', label: 'Visão Geral', active: true
  = render 'shared/nav_tab_link', id: 'pontos', icon: 'bi-hdd-network', label: 'Pontos de Acesso', badge: @servidor.pontos.count
  = render 'shared/nav_tab_link', id: 'enlaces', icon: 'bi-link-45deg', label: 'Enlaces'
  = render 'shared/nav_tab_link', id: 'autenticacao', icon: 'bi-shield-lock', label: 'Autenticação'
  = render 'shared/nav_tab_link', id: 'os', icon: 'bi-clipboard-check', label: 'Ordens de Serviço'

/ Tab Content
.tab-content
  = render 'servidores/tabs/overview', servidor: @servidor, online: @online
  = render 'servidores/tabs/pontos', servidor: @servidor
  = render 'servidores/tabs/enlaces', servidor: @servidor
  = render 'servidores/tabs/autenticacao', servidor: @servidor
  = render 'servidores/tabs/os', servidor: @servidor