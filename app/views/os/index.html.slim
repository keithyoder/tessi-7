- unless incorporado?
  .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.mb-4.gap-3
    div
      h2.mb-1 Ordens de Serviço
      p.text-muted.mb-0
        = @pagy.count
        |  OS encontradas

    .d-flex.gap-2
      - if can? :create, Os
        = link_to new_os_path, class: 'btn btn-primary'
          i.bi.bi-plus-lg.me-1
          | Nova OS

  .card.border-0.shadow-sm.mb-4
    .card-body.py-3
      = search_form_for(@q, url: request.original_url, html: { class: 'd-flex flex-column flex-md-row gap-3' }) do |f|
        .flex-grow-1
          = f.search_field :pessoa_nome_cont, value: params.dig(:q, :pessoa_nome_cont), \
            class: 'form-control', placeholder: 'Buscar por assinante...'

        .flex-shrink-0
          = select_tag 'q[cidade]', \
            options_for_select(Cidade.atendidas.collect { |c| [c.nome, c.id] }, params.dig(:q, :cidade)), \
            include_blank: 'Todas as cidades', class: 'form-select form-select-sm'

        .flex-shrink-0
          = select_tag 'q[tipo_eq]', \
            options_for_select(Os.tipos, params.dig(:q, :tipo_eq)), \
            include_blank: 'Todos os tipos', class: 'form-select form-select-sm'

        - fechamento_val = params.dig(:q, :fechamento_null)
        .btn-group.flex-shrink-0 role="group"
          = link_to 'Abertas', os_index_path(q: @search_params.merge('fechamento_null' => '1')), \
            class: "btn btn-sm #{fechamento_val == '1' ? 'btn-success' : 'btn-outline-secondary'}"
          = link_to 'Fechadas', os_index_path(q: @search_params.merge('fechamento_null' => '0')), \
            class: "btn btn-sm #{fechamento_val == '0' ? 'btn-secondary' : 'btn-outline-secondary'}"
          = link_to 'Todas', os_index_path(q: @search_params.except('fechamento_null')), \
            class: "btn btn-sm #{fechamento_val.blank? ? 'btn-primary' : 'btn-outline-secondary'}"

        = button_tag class: 'btn btn-sm btn-primary'
          i.bi.bi-search

= turbo_frame_tag id_frame do
  .card.border-0.shadow-sm
    .table-responsive
      table.table.table-hover.align-middle.mb-0
        thead
          tr.text-muted.small.text-uppercase
            th.ps-4 Status
            th= sort_link(@q, :created_at, 'Aberta', default_order: :desc)
            - unless incorporado?
              th= sort_link(@q, :pessoa_nome, 'Assinante')
            th= sort_link(@q, :tipo)
            th.d-none.d-md-table-cell Classificação
            th.d-none.d-lg-table-cell= sort_link(@q, :responsavel, 'Responsável')
            th.d-none.d-lg-table-cell Fechada
        tbody
          - @os.each do |os|
            tr
              td.ps-4
                - if os.fechamento.nil?
                  span.badge.bg-warning.text-dark Aberta
                - else
                  span.badge.bg-secondary Fechada
              td= l(os.created_at, format: :date_time)
              - unless incorporado?
                td= link_to os.pessoa.nome, os.pessoa, class: 'text-decoration-none', data: { turbo_frame: '_top' }
              td
                .fw-semibold= link_to os.tipo, os_path(os), class: 'text-decoration-none', data: { turbo_frame: '_top' }
              td.d-none.d-md-table-cell= os.classificacao&.nome || '—'
              td.d-none.d-lg-table-cell= os.responsavel.primeiro_nome
              td.d-none.d-lg-table-cell= os.fechamento.present? ? l(os.fechamento, format: :date_time) : '—'

    - if @pagy.pages > 1
      .card-footer.bg-transparent.border-top.d-flex.justify-content-center.py-3
        == pagy_bootstrap_nav(@pagy)