/ app/views/conexoes/show.html.slim

/ Hero Section
.row.mb-4
  .col-12
    .card.border-0.shadow-sm
      .card-body.p-4
        .d-flex.justify-content-between.align-items-start.flex-wrap
          div
            .d-flex.align-items-center.gap-3.mb-2.flex-wrap
              h2.mb-0 = "Conexão de #{@conexao.pessoa.nome}"
              - if @conexao.conectado
                span.badge.bg-success.fs-6
                  i.bi.bi-wifi
                  = " Conectada"
              - else
                span.badge.bg-secondary.fs-6
                  i.bi.bi-wifi-off
                  = " Desconectada"
              - if @conexao.bloqueado
                span.badge.bg-warning.text-dark.fs-6
                  i.bi.bi-slash-circle
                  = " Suspensa"
              - if @conexao.inadimplente
                span.badge.bg-danger.fs-6
                  i.bi.bi-exclamation-circle
                  = " Inadimplente"
            .text-muted
              = @conexao.tipo
              = " • "
              = link_to @conexao.plano.nome, @conexao.plano, class: "text-decoration-none"
              = " • "
              = link_to @conexao.ponto.nome, @conexao.ponto, class: "text-decoration-none"

          .d-flex.gap-2.mt-3.mt-md-0
            = back_button(conexoes_path)
            = edit_button(@conexao)
            = delete_button(@conexao)

/ Pendências (OS / Atendimento abertos)
= render 'alerta_pendencias', conexao: @conexao, os_abertas: @os_abertas, atendimentos_abertos: @atendimentos_abertos

/ Quick Stats
.row.g-3.mb-4
  .col-lg-3.col-md-4.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 IP
        .fs-5.fw-bold.text-primary = @conexao.ip
  .col-lg-3.col-md-4.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Usuário
        .fs-5.fw-bold = @conexao.usuario
  .col-lg-3.col-md-4.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Equipamento
        .fs-5.fw-bold = @conexao.equipamento&.descricao || "Desconhecido"
  .col-lg-3.col-md-4.col-6
    .card.border-0.shadow-sm.h-100
      .card-body.text-center
        .text-muted.small.mb-1 Criada em
        .fs-5.fw-bold = @conexao.created_at.strftime('%d/%m/%Y')

/ Navigation Tabs
ul.nav.nav-tabs.mb-4 role="tablist"
  li.nav-item role="presentation"
    button.nav-link.active[
      id="overview-tab"
      data-bs-toggle="tab"
      data-bs-target="#overview"
      type="button"
      role="tab"
    ]
      i.bi.bi-info-circle.me-2
      | Visão Geral

  li.nav-item role="presentation"
    button.nav-link[
      id="radius-tab"
      data-bs-toggle="tab"
      data-bs-target="#radius"
      type="button"
      role="tab"
    ]
      i.bi.bi-router.me-2
      | Radius

  li.nav-item role="presentation"
    button.nav-link[
      id="autenticacao-tab"
      data-bs-toggle="tab"
      data-bs-target="#autenticacao"
      type="button"
      role="tab"
    ]
      i.bi.bi-shield-check.me-2
      | Autenticação

  li.nav-item role="presentation"
    button.nav-link[
      id="trafego-tab"
      data-bs-toggle="tab"
      data-bs-target="#trafego"
      type="button"
      role="tab"
    ]
      i.bi.bi-graph-up.me-2
      | Tráfego

/ Tab Content
.tab-content
  = render 'conexoes/tabs/overview', conexao: @conexao
  = render 'conexoes/tabs/radius', conexao: @conexao
  = render 'conexoes/tabs/autenticacao', conexao: @conexao
  = render 'conexoes/tabs/trafego', conexao: @conexao