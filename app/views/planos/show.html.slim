/ app/views/planos/show.html.slim

/ Header
.d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.mb-4.gap-3
  div
    h2.mb-1= @plano.nome
    p.text-muted.mb-0 Plano de Acesso

  .d-flex.gap-2
    = back_button planos_path
    = edit_button @plano
    = delete_button @plano, confirm: "Excluir o plano #{@plano.nome}?"

/ Detalhes
.card.border-0.shadow-sm.mb-4
  .card-header.bg-transparent.fw-semibold Detalhes
  .card-body
    .row.g-4
      .col-6.col-md-4.col-lg-3
        .text-muted.small.text-uppercase.mb-1 Mensalidade
        .fw-semibold= number_to_currency(@plano.mensalidade, unit: 'R$ ', separator: ',', delimiter: '.')

      .col-6.col-md-4.col-lg-3
        .text-muted.small.text-uppercase.mb-1 Desconto
        .fw-semibold
          - if @plano.desconto.present? && @plano.desconto > 0
            span.text-success= number_to_currency(@plano.desconto, unit: 'R$ ', separator: ',', delimiter: '.')
          - else
            span.text-muted —

      .col-6.col-md-4.col-lg-3
        .text-muted.small.text-uppercase.mb-1 Download
        .fw-semibold= "#{@plano.download} Mbps"

      .col-6.col-md-4.col-lg-3
        .text-muted.small.text-uppercase.mb-1 Upload
        .fw-semibold= "#{@plano.upload} Mbps"

      .col-6.col-md-4.col-lg-3
        .text-muted.small.text-uppercase.mb-1 Velocidade
        span.badge.bg-light.text-dark.font-monospace= plano_velocidade(@plano)

      .col-6.col-md-4.col-lg-3
        .text-muted.small.text-uppercase.mb-1 Burst
        - if @plano.burst?
          span.badge.bg-warning.text-dark
            i.bi.bi-lightning-fill.me-1
            | Ativado
        - else
          span.text-muted Desativado

      .col-6.col-md-4.col-lg-3
        .text-muted.small.text-uppercase.mb-1 Status
        - if @plano.ativo?
          span.badge.bg-success Ativo
        - else
          span.badge.bg-danger Inativo

      .col-6.col-md-4.col-lg-3
        .text-muted.small.text-uppercase.mb-1 Garantia
        .fw-semibold= "#{@plano.garantia}%"

/ Radius
.card.border-0.shadow-sm.mb-4
  .card-header.bg-transparent.fw-semibold Radius — Verificar
  .card-body.p-0
    = render 'plano_verificar_atributos/table'

.card.border-0.shadow-sm
  .card-header.bg-transparent.fw-semibold Radius — Enviar
  .card-body.p-0
    = render 'plano_enviar_atributos/table'