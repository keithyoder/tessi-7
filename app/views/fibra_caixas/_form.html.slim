= simple_form_for(@fibra_caixa) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  / ── Identificação ───────────────────────────────────────────────────
  .card.mb-3
    .card-header Identificação
    .card-body
      .row.g-3
        .col-12.col-md-4
          = f.input :nome
        .col-12.col-md-4
          = f.association :fibra_rede, collection: FibraRede.order(:nome), label_method: :nome
        .col-12.col-sm-6.col-md-2
          = f.input :capacidade
        .col-12.col-sm-6.col-md-2
          = f.input :poste

  / ── Endereço ─────────────────────────────────────────────────────────
  .card.mb-3
    .card-header Endereço
    .card-body[data-controller="busca" data-busca-url-value="/logradouros.json" data-busca-campos-meta-value='["bairro","cidade"]']
      .row.g-3
        .col-12.col-md-4
          = f.input :fibra_cor, collection: FibraCaixa.fibra_cores.keys
        .col-12.col-md-8
          .form-group
            label.form-label Logradouro
            .position-relative
              = f.hidden_field :logradouro_id, data: { busca_target: "id" }
              input.form-control type="text" placeholder="Digite para buscar..." value=@fibra_caixa.logradouro&.endereco autocomplete="off" data-busca-target="input" data-action="input->busca#buscar"

  = render partial: 'shared/localizacao', locals: { f:, titulo: f.object.nome.presence || 'Localização' }

  .d-flex.justify-content-between.align-items-center
    - if @fibra_caixa.persisted?
      = link_to 'Cancelar', fibra_caixa_path(@fibra_caixa), class: 'btn btn-outline-secondary'
    - else
      = link_to 'Cancelar', fibra_caixas_path, class: 'btn btn-outline-secondary'
    = button_tag class: 'btn btn-primary px-4'
      i.bi.bi-check-lg.me-1
      |  Salvar